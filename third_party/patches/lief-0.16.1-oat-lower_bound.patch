+  // std::unordered_map (used when LIEF_DISABLE_FROZEN=ON) has no lower_bound().
+  // Scan for the smallest key >= version, preserving the ordered lower_bound()
+  // semantics of frozen::map without requiring an ordered container.
+  Android::ANDROID_VERSIONS result = Android::ANDROID_VERSIONS::VERSION_UNKNOWN;
+  bool found = false;
+  oat_version_t best = 0;
+  for (const auto& entry : oat2android) {
+    if (entry.first >= version && (!found || entry.first < best)) {
+      found = true;
+      best = entry.first;
+      result = entry.second;
+    }
+  }
